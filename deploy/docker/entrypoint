#!/bin/sh
# The image's entrypoint. Started as its own user (node, or whatever `user:` sets) it changes nothing and runs the
# server. Started as root on purpose (user: "0:0" with cap_add CHOWN, SETUID, SETGID: Unraid, CasaOS/ZimaOS), it gives
# the data folder to PUID:PGID (default 1000:1000), one level deep, and runs the server as them. Every path ends in exec:
# the server stays pid 1, so SIGTERM and the commands' SIGHUP reach it (docs/deploy-docker.md, "Running as another user").
set -eu
DATA_DIR="${DATA_DIR:-/data}"

# Keep diagnostic output off the stdout of commands such as monido-mcp.
if [ "${1:-}" = node ] && [ "${2:-}" = dist/server/main.js ]; then
  exec 3>&1
else
  exec 3>&2
fi
log_config() {
  node --input-type=module -e 'import { logEvent } from "/app/dist/server/log.js"; logEvent(...process.argv.slice(1))' "$@" >&3
}

if [ "$(id -u)" != 0 ]; then
  if { [ -n "${PUID:-}" ] && [ "$PUID" != "$(id -u)" ]; } || { [ -n "${PGID:-}" ] && [ "$PGID" != "$(id -g)" ]; }; then
    log_config WARN monido.config.uid_ignored 'PUID/PGID are used only when the container starts as root: set user: "0:0" with cap_add CHOWN, SETUID, SETGID, or set user: "PUID:PGID" instead.'
  fi
  exec "$@" 3>&-
fi

PUID="${PUID:-1000}"
PGID="${PGID:-1000}"
for id in "$PUID" "$PGID"; do
  case "$id" in
    '' | *[!0-9]*) log_config FATAL monido.config.invalid 'PUID and PGID must be numbers.'; exit 1 ;;
  esac
done

if [ "$PUID" = 0 ]; then
  log_config WARN monido.config.root_user 'PUID=0 runs the server as root. Set PUID to a non-root user.'
  exec "$@" 3>&-
fi

# checked before the data is touched: without the capabilities nothing would run as PUID anyway
if ! su-exec "$PUID:$PGID" true 2>/dev/null; then
  log_config FATAL monido.config.capabilities_missing 'Set cap_add to CHOWN, SETUID and SETGID to run as PUID and PGID.'
  exit 1
fi

mkdir -p "$DATA_DIR" 2>/dev/null || true
# the folder and each file in it, one level deep, links left alone (a whole share mounted by mistake is not walked):
# the folder's owner says nothing about its files'. A share may refuse (NFS, SMB); a private (0700) folder of another
# user cannot be read without cap_add DAC_READ_SEARCH
chown -h "$PUID:$PGID" "$DATA_DIR" 2>/dev/null || true
find "$DATA_DIR" -maxdepth 1 ! -type l \( ! -user "$PUID" -o ! -group "$PGID" \) -exec chown -h "$PUID:$PGID" {} + 2>/dev/null \
  || log_config WARN monido.config.ownership_failed 'Could not change ownership of every file in DATA_DIR. Check the share permissions and DAC_READ_SEARCH for private folders.'

exec su-exec "$PUID:$PGID" "$@" 3>&-
