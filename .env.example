# Optional: copy to .env, uncomment what you need, then run docker compose up -d.
# First start: open the app within 15 minutes and create your family password.
# Manage password and Telegram sign-in in Settings -> Family and access.

# Your site's public HTTPS address (for Telegram links and secure cookies).
# APP_URL=https://finance.example.com

# Local port (default: 8080).
# APP_PORT=8080

# Only behind a trusted reverse proxy that overwrites this header.
# CLIENT_IP_HEADER=X-Forwarded-For

# Special modes only. Leave unset for normal sign-in; choose at most one.
# none gives everyone full access. Never expose it to the internet.
# AUTH_MODE=none
# AUTH_MODE=demo

# All options: docs/configuration.md. Deployment: docs/deploy-docker.md.
